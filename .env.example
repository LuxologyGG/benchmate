# Demo mode (no API keys required). Auto-enabled when no keys are set.
DEMO_MODE=true

# Provider: auto | meta | baseten
MODEL_PROVIDER=auto

# ── Meta Model API (https://dev.meta.ai/docs/overview) ──────────────────────
# Base URL: https://api.meta.ai/v1  (OpenAI-compatible Chat Completions + Responses)
# Auth: Bearer META_API_KEY (MODEL_API_KEY also accepted)
META_API_KEY=
# MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Muse Spark 1.3 — vision-capable, 1M context (default)
META_MODEL=muse-spark-1.3
# META_MODEL_ID=muse-spark-1.3

# SAM 3.1 Segment (Responses API) — boxes/masks for readout regions
META_SAM_MODEL_ID=sam-3.1
# Optional request timeout (ms) for Meta/Baseten clients
META_REQUEST_TIMEOUT_MS=45000
# Muse Wonder used by scripts/muse-build orchestration (not required at runtime)
META_WONDER_MODEL=muse-wonder-1.0

# ── Muse Spark Open via Baseten (open-weight bonus path) ────────────────────
BASETEN_API_KEY=
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# -- Meta client timeout + retry --
# META_REQUEST_TIMEOUT_MS: per-request timeout in ms (default 45000).
# Retry: auto-retry with backoff on 429 and 5xx; other 4xx fail without retry.
# Security: never commit real API keys - keep .env local, placeholders only here.
