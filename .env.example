# ── BenchMate Course Lab (Global AI Builder's Challenge, Nov 2026) ─────────────
# Copy to .env.local (gitignored). Names only here; never commit real keys.
# Live is the default whenever GROQ_API_KEY is set. All providers below have free tiers.

# Groq (https://console.groq.com) — structured extraction of protocol steps + notebook values
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Google AI Studio / Gemini (https://aistudio.google.com) — optional notebook-photo transcription
GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Force the no-key path (recorded model output replay, clearly labeled) even if keys exist
COURSELAB_DEMO_MODE=false

# ── Classic BenchMate (/classic, Nov 4 Meta hackathon build) ────────────────────
# Without Meta keys the classic page replays its fixtures (DEMO_MODE).
DEMO_MODE=true
MODEL_PROVIDER=auto
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_SAM_MODEL_ID=sam-3.1
META_REQUEST_TIMEOUT_MS=45000
META_WONDER_MODEL=muse-wonder-1.0
META_SPARK_MODEL=muse-spark-1.3
BASETEN_API_KEY=
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
